def prime_factors(n):
    factors = []
    divisor = 2

    while n > 1:
        while n % divisor == 0:
            factors.append(divisor)
            n = n // divisor
        divisor += 1

    return factors


num = int(input("Enter a number: "))

if num > 1:
    print("Prime factors are:", prime_factors(num))
else:
    print("Please enter a number greater than 1.")